# Optional Jolt backend. The source checkout stays outside this repository.
option(FTE_PLUG_JOLT "Build the experimental Jolt rigid-body physics plugin." OFF)
set(FTE_JOLT_SOURCE_DIR "" CACHE PATH "Path to the Jolt Physics source checkout (5.6.x).")
option(FTE_JOLT_ODE_REFERENCE "Include installed ODE in Jolt adapter comparison tests." ON)
if(NOT FTE_PLUG_JOLT)
    return()
endif()
if(NOT EXISTS "${FTE_JOLT_SOURCE_DIR}/Build/CMakeLists.txt")
    message(FATAL_ERROR "FTE_PLUG_JOLT requires FTE_JOLT_SOURCE_DIR pointing to a Jolt Physics checkout.")
endif()
# Scope upstream compiler options to its subdirectory; never apply them to the
# C17 engine, existing C++ tools, or the production C/C++ adapter.
function(fte_add_jolt)
    set(OVERRIDE_CXX_FLAGS OFF)
    # Inherit the engine/toolchain CRT; upstream otherwise forces /MT on MSVC.
    set(USE_STATIC_MSVC_RUNTIME_LIBRARY OFF)
    # Match the adapter: UBSan vptr checks require typeinfo across this boundary.
    set(CPP_RTTI_ENABLED ON)
    set(INTERPROCEDURAL_OPTIMIZATION OFF)
    set(ENABLE_ALL_WARNINGS OFF)
    set(ENABLE_INSTALL OFF)
    set(JPH_BUILD_SHARED_LIBS OFF)
    set(DOUBLE_PRECISION ON)
    set(CROSS_PLATFORM_DETERMINISTIC ON)
    set(DEBUG_RENDERER_IN_DEBUG_AND_RELEASE OFF)
    set(PROFILER_IN_DEBUG_AND_RELEASE OFF)
    set(ENABLE_OBJECT_STREAM OFF)
    set(JPH_USE_DX12 OFF)
    set(JPH_USE_VK OFF)
    set(JPH_USE_MTL OFF)
    set(JPH_USE_CPU_COMPUTE OFF)
    foreach(feature SSE4_1 SSE4_2 AVX AVX2 AVX512 LZCNT TZCNT F16C FMADD)
        set(USE_${feature} OFF)
    endforeach()
    add_subdirectory("${FTE_JOLT_SOURCE_DIR}/Build" "${CMAKE_BINARY_DIR}/jolt-dependency" EXCLUDE_FROM_ALL)
endfunction()
fte_add_jolt()
set_target_properties(Jolt PROPERTIES POSITION_INDEPENDENT_CODE ON)
add_library(fte-jolt-adapter STATIC plugins/jolt/jolt_api.cpp)
set_target_properties(fte-jolt-adapter PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON)
target_include_directories(fte-jolt-adapter PUBLIC "${PROJECT_SOURCE_DIR}")
target_link_libraries(fte-jolt-adapter PUBLIC Jolt)
if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    target_compile_options(fte-jolt-adapter PRIVATE -Wall -Wextra -Werror)
elseif(MSVC)
    target_compile_options(fte-jolt-adapter PRIVATE /W4)
endif()
add_library(plug_jolt MODULE plugins/plugin.c engine/common/com_phys_jolt.c)
target_compile_definitions(plug_jolt PRIVATE FTEPLUGIN ${FTE_LIB_DEFINES})
target_link_libraries(plug_jolt PRIVATE fte-jolt-adapter ${SYS_LIBS})
EMBED_PLUGIN_META(jolt "Jolt Physics (experimental)" "Opt-in rigid props, point/fixed/hinge/slider/universal/hinge2 joints, and experimental skeletal rigs.")
# Jolt is statically linked into the module; retain its MIT notice with builds.
configure_file("${PROJECT_SOURCE_DIR}/plugins/jolt/Jolt-LICENSE.txt"
    "${CMAKE_BINARY_DIR}/Jolt-LICENSE.txt" COPYONLY)
install(FILES "${PROJECT_SOURCE_DIR}/plugins/jolt/Jolt-LICENSE.txt"
    DESTINATION "${CMAKE_INSTALL_DATAROOTDIR}/doc/FTEQWDelta")
