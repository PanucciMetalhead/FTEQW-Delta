set(FTE_SERVER_PGO "off" CACHE STRING "Dedicated server profile-guided optimization mode: off, generate, or use.")
set_property(CACHE FTE_SERVER_PGO PROPERTY STRINGS off generate use)
set(FTE_SERVER_PROFILE "" CACHE FILEPATH "Merged LLVM profile for FTE_SERVER_PGO=use.")

if(FTE_SERVER_PGO STREQUAL "off")
    return()
endif()
if(NOT FTE_SERVER_PGO MATCHES "^(generate|use)$")
    message(FATAL_ERROR "FTE_SERVER_PGO must be off, generate, or use.")
endif()
if(NOT TARGET fteqw-sv)
    message(FATAL_ERROR "FTE_SERVER_PGO requires the fteqw-sv target (FTE_ENGINE_SERVER_ONLY=ON).")
endif()
if(NOT CMAKE_C_COMPILER_ID MATCHES "^(AppleClang|Clang)$" OR
   NOT CMAKE_SYSTEM_NAME MATCHES "^(Darwin|Linux)$" OR CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "FTE_SERVER_PGO requires native Clang on Linux or macOS.")
endif()
if(CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_BUILD_TYPE STREQUAL "Release" OR FTE_SANITIZERS)
    message(FATAL_ERROR "FTE_SERVER_PGO requires a single-configuration Release build without sanitizers.")
endif()

if(FTE_SERVER_PGO STREQUAL "generate")
    target_compile_options(fteqw-sv PRIVATE -fprofile-generate)
    target_link_options(fteqw-sv PRIVATE -fprofile-generate)
else()
    get_filename_component(profile "${FTE_SERVER_PROFILE}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    if(NOT FTE_SERVER_PROFILE OR NOT EXISTS "${profile}" OR IS_DIRECTORY "${profile}")
        message(FATAL_ERROR "FTE_SERVER_PGO=use requires FTE_SERVER_PROFILE to point to a merged LLVM profile.")
    endif()
    # Track the input and change the compile command when its contents change.
    file(SHA256 "${profile}" profile_hash)
    set(profile_copy "${CMAKE_CURRENT_BINARY_DIR}/server-${profile_hash}.profdata")
    configure_file("${profile}" "${profile_copy}" COPYONLY)
    target_compile_options(fteqw-sv PRIVATE "-fprofile-use=${profile_copy}" -Werror=profile-instr-out-of-date)
    unset(profile)
    unset(profile_hash)
    unset(profile_copy)
endif()
message(STATUS "Dedicated server PGO: ${FTE_SERVER_PGO}")
